#!/bin/sh
# Flash a white bar on the right edge of the screen without blocking the caller.
# Usage: pinger [seconds]. Prints nothing, so it is safe to use as a hook.
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
BIN="$DIR/bin/pinger-overlay"
if [ ! -x "$BIN" ] || [ "$DIR/pinger.swift" -nt "$BIN" ]; then
  mkdir -p "$DIR/bin"
  swiftc -O "$DIR/pinger.swift" -o "$BIN" >/dev/null 2>&1 || exit 0
fi
[ -t 0 ] || cat >/dev/null   # drain hook JSON on stdin
nohup "$BIN" "${1:-3}" >/dev/null 2>&1 &
exit 0
